# MeiliOps hosted mode: the web app plus a small Node server that proxies to
# Meilisearch with keys from the environment. See docs/guide/hosted.md.
#
#   podman build -t meiliops-web -f Containerfile .      (from app/)
#
# Published by .github/workflows/release.yml as ghcr.io/srilals/meiliops-web for amd64 and arm64.

# The build output (JS, HTML, CSS) is the same for every CPU, so this stage runs on the build
# machine's own platform: a multi-arch build only emulates the small runtime stage below.
FROM --platform=$BUILDPLATFORM docker.io/library/node:24-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:web

# Runtime: Alpine's own Node.js, no npm and no node_modules (the server has no dependencies).
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache nodejs \
 && adduser -D -H -u 10001 meiliops
WORKDIR /app
COPY --from=build /src/dist-server ./
RUN echo '{"type":"module"}' > package.json
USER 10001
ENV PORT=8080
EXPOSE 8080
CMD ["node", "main.js"]
