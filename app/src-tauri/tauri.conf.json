{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeiliOps",
  "version": "0.3.0",
  "identifier": "io.meiliops.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeiliOps",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#13002a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,OptimizationHints,MediaRouter,SpareRendererForSitePerProcess,AudioServiceOutOfProcess,IsolateOrigins,site-per-process --enable-features=NetworkServiceInProcess2 --disable-background-networking --disable-component-update --disable-sync --disable-extensions --no-first-run --disable-default-apps --renderer-process-limit=1 --disable-site-isolation-trials --in-process-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MeiliOps contributors",
    "copyright": "MIT License",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Native desktop admin app for Meilisearch",
    "longDescription": "MeiliOps is a fast, memory-efficient desktop admin app for Meilisearch: documents, search, settings, tasks, keys, and local instance management.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
