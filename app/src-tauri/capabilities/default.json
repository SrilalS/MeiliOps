{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "store:default",
    "os:default",
    "upload:allow-download",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "podman",
          "cmd": "podman",
          "args": true
        },
        {
          "name": "docker-usr-local",
          "cmd": "/usr/local/bin/docker",
          "args": true
        },
        {
          "name": "podman-usr-local",
          "cmd": "/usr/local/bin/podman",
          "args": true
        },
        {
          "name": "docker-homebrew",
          "cmd": "/opt/homebrew/bin/docker",
          "args": true
        },
        {
          "name": "podman-homebrew",
          "cmd": "/opt/homebrew/bin/podman",
          "args": true
        },
        {
          "name": "podman-opt",
          "cmd": "/opt/podman/bin/podman",
          "args": true
        },
        {
          "name": "docker-app",
          "cmd": "/Applications/Docker.app/Contents/Resources/bin/docker",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "podman",
          "cmd": "podman",
          "args": true
        },
        {
          "name": "docker-usr-local",
          "cmd": "/usr/local/bin/docker",
          "args": true
        },
        {
          "name": "podman-usr-local",
          "cmd": "/usr/local/bin/podman",
          "args": true
        },
        {
          "name": "docker-homebrew",
          "cmd": "/opt/homebrew/bin/docker",
          "args": true
        },
        {
          "name": "podman-homebrew",
          "cmd": "/opt/homebrew/bin/podman",
          "args": true
        },
        {
          "name": "podman-opt",
          "cmd": "/opt/podman/bin/podman",
          "args": true
        },
        {
          "name": "docker-app",
          "cmd": "/Applications/Docker.app/Contents/Resources/bin/docker",
          "args": true
        },
        {
          "name": "meilisearch-legacy-win",
          "cmd": "$APPLOCALDATA/bin/meilisearch.exe",
          "args": [
            "--version"
          ]
        },
        {
          "name": "meilisearch-legacy",
          "cmd": "$APPLOCALDATA/bin/meilisearch",
          "args": [
            "--version"
          ]
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}
